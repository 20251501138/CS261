@startuml class-diagram
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam packageStyle rectangle
skinparam roundcorner 4
skinparam defaultFontName Arial

' --- Enums ---
enum Category {
  GENERAL
  OBC
  SC
  ST
  EWS
  PWBD
}

enum BatchStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  DOCS_VERIFIED
  DISCREPANCY_FLAGGED
  ADMIT_CARD_ISSUED
  REJECTED
}

' --- Base Abstract Class ---
abstract class User {
  # userId: string
  # passwordHash: string
  # fullName: string
  # email: string
  # phone: string
  + login(password: string): bool
  + {abstract} showDashboard(): void
  + getUserId(): string
}

' --- Derived User Classes ---
class Candidate {
  - rollNumber: string
  - dob: string
  - category: Category
  + registerExam(cycleId: string): void
  + checkAdmitCard(): void
  + checkResult(): void
  + requestRevaluation(scriptId: string): void
}

class ExamAdministrator {
  - adminEmpId: string
  + verifyCandidateDocs(appId: string, isApproved: bool): void
  + assignBatchToExaminer(batchId: string, examinerId: string): void
  + approveMeritList(listId: string): void
  + publishResult(stage: string): void
}

class Examiner {
  - examinerCode: string
  - assignedSubject: string
  + enterMarks(scriptId: string, qMarks: vector<double>): void
  + submitBatch(batchId: string): void
}

' --- Core Domain Classes ---
class Application {
  - applicationId: string
  - candidateId: string
  - optionalSubject: string
  - preferredCenter: string
  - paymentConfirmed: bool
  - appStatus: ApplicationStatus
  - remark: string
  + makePayment(): void
  + submitApplication(): void
  + flagDiscrepancy(reason: string): void
}

class AnswerScript {
  - maskedScriptId: string
  - candidateRollNo: string
  - subject: string
  - marksList: vector<double>
  - totalMarks: double
  - isGradingLocked: bool
  + addQuestionScore(score: double): void
  + calculateTotal(): double
  + lockScript(): void
}

class EvaluationBatch {
  - batchId: string
  - subjectName: string
  - totalScripts: int
  - currentStatus: BatchStatus
  + addScriptToBatch(script: AnswerScript): void
  + finalizeBatch(): void
}

class MeritList {
  - listId: string
  - examStage: string
  - isPublished: bool
  + computeRankings(): void
  + filterByCutoff(policy: ReservationPolicy): void
  + resolveTies(): void
}

class ReservationPolicy {
  - policyYear: int
  - quotaMap: map<Category, double>
  + getCategoryCutoff(category: Category, scores: vector<double>): double
}

class NotificationService {
  + sendEmailAlert(email: string, message: string): void
  + sendSMSAlert(phone: string, message: string): void
}

' --- Relationships ---
User <|-- Candidate
User <|-- ExamAdministrator
User <|-- Examiner

Candidate "1" *-- "1" Application : submits >
Candidate "1" o-- "1..*" AnswerScript : writes >
Application ..> NotificationService : triggers

EvaluationBatch "1" *-- "1..*" AnswerScript : contains >
Examiner "1" --> "0..*" EvaluationBatch : grades >
ExamAdministrator "1" --> "0..*" EvaluationBatch : allocates >

ExamAdministrator "1" --> "1..*" MeritList : approves >
MeritList "1" --> "1" ReservationPolicy : uses >
MeritList "1" o-- "1..*" Candidate : ranks >

@enduml